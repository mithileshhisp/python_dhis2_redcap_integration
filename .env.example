
# ==========================================================
# DHIS2 CONNECTION CONFIGURATION
# ==========================================================

DHIS2_BASE_URL=https://your-dhis2-server/api/
DHIS2_API_URL=https://your-dhis2-server/api/

DHIS2_USERNAME=your_dhis2_username
DHIS2_PASSWORD=your_dhis2_password

# ==========================================================
# DHIS2 ORGANISATION UNIT AND PROGRAM CONFIGURATION
# ==========================================================

DHIS2_ORG_UNIT_ID=YOUR_ORG_UNIT_UID

# Gram Positive
DHIS2_PROGRAM_ID_GRAM_POSITIVE=YOUR_GP_PROGRAM_UID
DHIS2_PROGRAM_STAGE_ID_GP_SAMPLE_TESTING=YOUR_GP_STAGE_UID

# Gram Negative
DHIS2_PROGRAM_ID_GRAM_NEGATIVE=YOUR_GN_PROGRAM_UID
DHIS2_PROGRAM_STAGE_ID_GN_SAMPLE_TESTING=YOUR_GN_STAGE_UID

# ==========================================================
# DHIS2 TRACKED ENTITY SEARCH CONFIGURATION
# ==========================================================

SEARCH_TEI_ATTRIBUTE_UID=YOUR_STUDY_ID_ATTRIBUTE_UID
SEARCH_VALUE=YOUR_SEARCH_FILTER_VALUE

# ==========================================================
# DHIS2 METADATA MAPPING CONFIGURATION
# ==========================================================

# Data Element metadata attribute containing REDCap field name
META_ATTRIBUTE_REDCAP_HEADER=YOUR_METADATA_ATTRIBUTE_UID

# Option metadata attribute containing REDCap option value
META_ATTRIBUTE_REDCAP_CODE=YOUR_METADATA_ATTRIBUTE_UID

# ==========================================================
# DHIS2 DATA ELEMENT CONFIGURATION
# ==========================================================

# Event synchronization status
REDCAP_SYNC_STATUS_DATAELEMENT_UID=YOUR_SYNC_STATUS_DE_UID

# Additional isolate indicator
DHIS2_DE_ISOLATE=YOUR_ISOLATE_DE_UID

# Pathogen information
DHIS2_DE_PATHOGEN_NAME=YOUR_PATHOGEN_NAME_DE_UID
DHIS2_DE_AST_MIC=YOUR_AST_MIC_DE_UID

# Sample information
DHIS2_DE_SAMPLE_TYPE=YOUR_SAMPLE_TYPE_DE_UID
DHIS2_DE_ANTIBIOTIC_TREATMENT=YOUR_ANTIBIOTIC_TREATMENT_DE_UID

# ==========================================================
# REDCAP API CONFIGURATION
# ==========================================================

# REDCap API URL
REDCAP_URL=https://your-redcap-server/api/

# REDCap API Token
REDCAP_TOKEN=YOUR_REDCAP_API_TOKEN

# Compatibility variables used by utils.py
REDCAP_API_BASE_URL=https://your-redcap-server/api/
REDCAP_API_TOKEN=YOUR_REDCAP_API_TOKEN

# ==========================================================
# REDCAP EVENT AND REPEATING INSTRUMENT
# ==========================================================

REDCAP_EVENT_NAME=ipc_crfs_arm_1

REDCAP_REPEAT_INSTRUMENT=microbiology

# Optional: next repeat instance is calculated dynamically
REDCAP_REPEAT_INSTANCE=1